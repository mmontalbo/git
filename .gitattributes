* whitespace=trail,space
*.[ch] whitespace=indent,trail,space,incomplete diff=cpp
*.sh whitespace=indent,trail,space,incomplete text eol=lf
*.perl text eol=lf diff=perl
*.pl text eol=lf diff=perl
*.pm text eol=lf diff=perl
*.py text eol=lf diff=python
*.bat text eol=crlf
CODE_OF_CONDUCT.md -whitespace
/Documentation/**/*.adoc text eol=lf whitespace=trail,space,incomplete
/command-list.txt text eol=lf
/GIT-VERSION-GEN text eol=lf
/mergetools/* text eol=lf
/t/oid-info/* text eol=lf
/Documentation/git-merge.adoc conflict-marker-size=32
/Documentation/git-merge-file.adoc conflict-marker-size=32
/Documentation/gitk.adoc conflict-marker-size=32
/Documentation/user-manual.adoc conflict-marker-size=32
/t/t????-*.sh conflict-marker-size=32
/t/unit-tests/clar/test/expected/* whitespace=-blank-at-eof
/templates/hooks/*.sample whitespace=indent,trail,space,incomplete text eol=lf
/commit-graph.c  organize.subsystem=pack
/commit-graph.h  organize.subsystem=pack
/commit-reach.c  organize.subsystem=revision
/commit-reach.h  organize.subsystem=revision
/diff-delta.c    organize.subsystem=pack
/patch-delta.c   organize.subsystem=pack
/pack-refs.c     organize.subsystem=refs
/pack-refs.h     organize.subsystem=refs
/server-info.c   organize.subsystem=refs
/server-info.h   organize.subsystem=refs
