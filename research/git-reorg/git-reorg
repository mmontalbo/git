#!/usr/bin/env python3
"""git-reorg: enforce a declared source layout.

Usage:
  git reorg check [--map FILE]   report files whose area does not match
                                 the directory its area maps to
  git reorg plan [--area X] [--map FILE]
                                 dry run: show one area's moves and its
                                 include, build, and pairing effects
  git reorg apply --area X [--commit]
                                 perform one area's carve: git mv the
                                 pairs, rewrite includes, patch the
                                 build lists, build, and stop before
                                 commit unless --commit is given

The map is "directory: area area ..." per line (see git-layout.map).
Each file's area is the prefix its commits use most often, weighted so
small commits count more than large sweeps. A per-path 'area=' attribute
in .gitattributes overrides the inferred label for cross-cutting files.
"""
import os
import re
import sys
import subprocess
from collections import defaultdict

TOP = subprocess.check_output(
    ["git", "rev-parse", "--show-toplevel"], text=True).strip()


def git(*a, allow=(0,)):
    """Run git and return stdout. Exit loudly on an exit code not in
    allow, so a broken repo fails instead of reporting an empty
    result. Pass allow=(0, 1) where no-match is expected (grep)."""
    r = subprocess.run(["git", "-C", TOP, *a],
                       capture_output=True, text=True)
    if r.returncode not in allow:
        sys.exit(f"git {' '.join(a)}: {r.stderr.strip()}")
    return r.stdout


def load_map(path):
    """token -> directory, from 'directory: area area ...' lines."""
    owner = {}
    for line in open(path):
        line = line.split("#", 1)[0].strip()
        if not line or ":" not in line:
            continue
        d, areas = line.split(":", 1)
        for a in areas.split():
            owner[a] = d.strip()
    return owner


PRE = re.compile(r"^([A-Za-z0-9][\w./-]*):")


def norm(p):
    p = p.lower()
    return p[:-2] if p.endswith((".c", ".h")) else p


def file_areas(scope):
    """Modal focus-weighted area label per file in scope, or None if
    the history is thin or split."""
    wt = defaultdict(lambda: defaultdict(float))
    lab, touched = None, []
    log = git("log", "--no-merges", "--name-only", "--format=%x00%s")
    for line in log.split("\n"):
        if line.startswith("\x00"):
            if lab and touched:
                w = 1.0 / len(touched)
                for f in set(touched):
                    wt[f][lab] += w
            m = PRE.match(line[1:])
            lab = norm(m.group(1)) if m else None
            touched = []
        elif line in scope:
            touched.append(line)
    if lab and touched:
        w = 1.0 / len(touched)
        for f in set(touched):
            wt[f][lab] += w
    areas = {}
    for f, c in wt.items():
        l, w = max(c.items(), key=lambda kv: (kv[1], kv[0]))
        tot = sum(c.values())
        if tot >= 2.0 and w / tot >= 0.34:
            areas[f] = l
    return areas


def read_overrides(scope):
    """path -> declared 'area=' value for paths in scope that set it.

    Batches one 'git check-attr area --stdin -z' over the scope. The
    NUL stream is path, attr, value triples; keep values that are set
    and not 'unspecified'."""
    files = sorted(scope)
    if not files:
        return {}
    r = subprocess.run(
        ["git", "-C", TOP, "check-attr", "area", "--stdin", "-z"],
        input="\0".join(files) + "\0",
        capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"git check-attr area: {r.stderr.strip()}")
    fields = r.stdout.split("\0")
    over = {}
    for i in range(0, len(fields) - 2, 3):
        path, _, value = fields[i], fields[i + 1], fields[i + 2]
        if value and value != "unspecified":
            over[path] = value
    return over


def labelled_areas(scope):
    """Inferred area per file with declared 'area=' overrides applied.

    The single labelling path for check, plan, and apply. A declared
    area= replaces the inferred label before token to directory
    resolution."""
    areas = file_areas(scope)
    for path, value in read_overrides(scope).items():
        areas[path] = value
    return areas


def token_of(area):
    """The map token for an area label."""
    return area.split("/")[0].split("-")[0]


def classify(owner, areas):
    """Split labelled files into (misfiled, tocreate).

    misfiled: (file, area, target) whose target dir exists.
    tocreate: target -> [files] whose target dir does not exist."""
    misfiled, tocreate = [], defaultdict(list)
    for f, area in sorted(areas.items()):
        target = owner.get(token_of(area))
        if not target or os.path.dirname(f) == target:
            continue
        if os.path.isdir(os.path.join(TOP, target)):
            misfiled.append((f, area, target))
        else:
            tocreate[target].append(f)
    return misfiled, tocreate


def root_scope():
    """Flat root *.c and *.h tracked files."""
    return {f for f in git("ls-files", "*.c", "*.h").split()
            if "/" not in f}


def area_dir(owner, area):
    """The directory the map assigns to an area name, or None."""
    return owner.get(area)


def cmd_check(mapfile):
    owner = load_map(mapfile)
    scope = root_scope()
    areas = labelled_areas(scope)
    misfiled, tocreate = classify(owner, areas)
    print(f"checked {len(areas)} labelled root files against "
          f"{os.path.basename(mapfile)}\n")
    if misfiled:
        print(f"misfiled: {len(misfiled)} files whose area directory "
              "already exists:")
        for f, area, target in misfiled:
            print(f"  {f}  ->  {target}/   (labelled '{area}:')")
        print()
    if tocreate:
        n = sum(len(v) for v in tocreate.values())
        print(f"would create: {n} files map to {len(tocreate)} "
              "directories that do not exist yet:")
        for target in dict.fromkeys(owner.values()):
            if target in tocreate:
                print(f"  {target}/   {len(tocreate[target])} files")
    if not misfiled and not tocreate:
        print("layout is clean: every labelled file is in its "
              "area's dir.")


def exists(path):
    """Whether path exists on disk under the worktree root."""
    return os.path.isfile(os.path.join(TOP, path))


def stem(path):
    """Filename without its .c or .h suffix."""
    base = os.path.basename(path)
    return base[:-2] if base.endswith((".c", ".h")) else base


INCLUDE = re.compile(
    r'^[ \t]*#[ \t]*include[ \t]+"([^"]+)"', re.M)


def binds_to_root(f, arg, h):
    """True when '#include \"arg\"' in file f binds to the repo root
    header h (a bare basename such as 'commit.h'). A quote include
    resolves against the includer's own directory first, then against
    the root via -I. Only a bind to the root h counts; a local shadow
    such as reftable/tree.h does not."""
    if os.path.basename(arg) != h:
        return False
    local = os.path.normpath(os.path.join(os.path.dirname(f), arg))
    if exists(local):
        return local == h
    return os.path.normpath(arg) == h


def include_edits(h):
    """[(file, arg)] for every tracked *.c/*.h include that binds to
    the root header h. Covers bare 'h' and relative '../h', excludes a
    local shadow and the doc or patch fixtures. This one set drives
    both the plan count and the apply rewrite, so they cannot
    diverge."""
    cand = git("grep", "-lE",
               r'#include[ \t]+"([^"]*/)?' + re.escape(h) + '"',
               "--", "*.c", "*.h", allow=(0, 1)).split()
    edits = []
    for f in cand:
        text = open(os.path.join(TOP, f), encoding="utf-8").read()
        for m in INCLUDE.finditer(text):
            if binds_to_root(f, m.group(1), h):
                edits.append((f, m.group(1)))
    return edits


def nonsource_refs(h):
    """Count of tracked '#include \"h\"' references in files that are
    not *.c/*.h (docs, patch fixtures). The rewrite leaves these as-is,
    so the plan reports them."""
    allf = set(git("grep", "-l", f'#include "{h}"',
                   allow=(0, 1)).split())
    src = set(git("grep", "-l", f'#include "{h}"',
                  "--", "*.c", "*.h", allow=(0, 1)).split())
    return len(allf - src)


def compute_plan(owner, area):
    """The move set for one area, with pairing applied.

    Returns (target, moves, paired, skipped, headers). The .c is the
    primary unit and pulls its same-stem .h. moves is a sorted list of
    (src, dst) pairs; paired is the set of headers pulled in by a .c
    and not flagged on their own; skipped is a list of (header, note);
    headers is the sorted list of moved header basenames."""
    target = area_dir(owner, area)
    areas = labelled_areas(root_scope())
    flagged = {f for f, a in areas.items()
               if owner.get(token_of(a)) == target
               and os.path.dirname(f) != target}
    moving_c = {f for f in flagged if f.endswith(".c")}
    moving_stems = {stem(f) for f in moving_c}
    move_set, paired, skipped = set(), set(), []
    for c in moving_c:
        move_set.add(c)
        h = stem(c) + ".h"
        if exists(h):
            move_set.add(h)
            if h not in flagged:
                paired.add(h)
    for h in flagged:
        if not h.endswith(".h"):
            continue
        c = stem(h) + ".c"
        if not exists(c):
            move_set.add(h)          # header-only lib, moves alone
        elif stem(h) not in moving_stems:
            skipped.append((h, f"paired {c} is unlabelled"))
    moves = sorted((f, f"{target}/{f}") for f in move_set)
    headers = sorted(f for f in move_set if f.endswith(".h"))
    return target, moves, paired, sorted(skipped), headers


def include_rewrites(headers, target):
    """(quoted_from, quoted_to, includer_count) per moved header, plus
    the total non-source references left as-is.

    The includer count is the resolver's include_edits() set that the
    apply rewrite acts over, counting distinct source files. The stale
    count is the tracked references in non-source files (docs, patch
    fixtures) that the rewrite leaves alone."""
    rows, stale = [], 0
    for h in headers:
        n = len({f for f, _ in include_edits(h)})
        stale += nonsource_refs(h)
        rows.append((f'"{h}"', f'"{target}/{h}"', n))
    return rows, stale


def cmd_plan(mapfile, area):
    owner = load_map(mapfile)
    if not area:
        areas = labelled_areas(root_scope())
        misfiled, tocreate = classify(owner, areas)
        by_dir = defaultdict(int)
        for _, _, t in misfiled:
            by_dir[t] += 1
        for t, fs in tocreate.items():
            by_dir[t] += len(fs)
        print("plan summary (candidate root files before pairing; "
              "pass --area X\nfor the exact move set):\n")
        for t in dict.fromkeys(owner.values()):
            if by_dir.get(t):
                print(f"  {t}/   {by_dir[t]} files")
        return
    target = area_dir(owner, area)
    if not target:
        sys.exit(f"git reorg plan: unknown area '{area}'")
    _, moves, paired, skipped, headers = compute_plan(owner, area)
    print(f"plan for area {area}  (dir {target}/)\n")
    print(f"moves: {len(moves)} files")
    for src, dst in moves:
        mark = "   (paired header)" if src in paired else ""
        print(f"  {src:<10}  ->  {dst}{mark}")
    rewrites, stale = include_rewrites(headers, target)
    n_files = sum(c for _, _, c in rewrites)
    print(f"\ninclude rewrites: {len(rewrites)} headers, "
          f"{n_files} including files")
    for frm, to, c in rewrites:
        print(f"  {frm:<12}  ->  {to}   ({c} files)")
    if stale:
        print(f"  note: {stale} non-source references (docs, patch "
              "fixtures) are left as-is")
    n_c = sum(1 for s, _ in moves if s.endswith(".c"))
    print("\nbuild edits:")
    print(f"  Makefile:    {n_c} LIB_OBJS lines")
    print(f"  meson.build: {n_c} source lines")
    if skipped:
        print("\nskipped:")
        for h, note in skipped:
            print(f"  {h}  ({note})")


def rewrite_includes(headers, target):
    """Rewrite each include that binds to a moved root header H to the
    from-root form '#include \"target/H\"'.

    include_edits(H) resolves both the bare form and the relative
    '../H' form, and excludes a subdir with its own same-basename
    header (a local shadow). From-root is correct at any depth via the
    root -I. Rewrites the quoted group only, so trailing comments
    survive. Guards: the new token must be absent (no double prefix)
    and moved header basenames must be unique in the include set. All
    edits for a file are applied in one read and one write."""
    seen = set()
    for h in headers:
        if h in seen:
            sys.exit(f"git reorg apply: duplicate header {h}")
        seen.add(h)
        present = git("grep", "-l", f'#include "{target}/{h}"',
                      allow=(0, 1)).split()
        if present:
            sys.exit(f"git reorg apply: '#include \"{target}/{h}\"' "
                     f"already present; refusing double prefix")
    per_file = defaultdict(list)
    for h in headers:
        for f, arg in include_edits(h):
            per_file[f].append((arg, h))
    for f, edits in per_file.items():
        p = os.path.join(TOP, f)
        text = open(p, encoding="utf-8").read()
        for arg, h in edits:
            pat = re.compile(
                r'(^[ \t]*#[ \t]*include[ \t]+)"'
                + re.escape(arg) + '"', re.M)
            text = pat.sub(r'\1"' + target + '/' + h + '"', text)
        open(p, "w", encoding="utf-8").write(text)


def patch_build(moved_c, target):
    """Full-line edit Makefile and meson.build for each moved .c.

    Each edit is a full-line regex that preserves leading whitespace
    and must match exactly once per name per file. A missing or
    duplicated line is a loud error, not a silent no-op."""
    for path, pat_t, rep_t in [
        ("Makefile", r'^([ \t]*)LIB_OBJS \+= {n}\.o$',
         r'\1LIB_OBJS += ' + target + r'/{n}.o'),
        ("meson.build", r"^([ \t]*)'{n}\.c',$",
         r"\1'" + target + r"/{n}.c',"),
    ]:
        p = os.path.join(TOP, path)
        text = open(p, encoding="utf-8").read()
        for c in moved_c:
            n = c[:-2]
            pat = re.compile(pat_t.format(n=re.escape(n)), re.M)
            new, k = pat.subn(rep_t.format(n=n), text)
            if k != 1:
                sys.exit(f"git reorg apply: {path}: expected 1 "
                         f"line for {n}, found {k}")
            text = new
        open(p, "w", encoding="utf-8").write(text)


RECOVER = "recover the pre-apply tree with: git reset --hard"


def tracked_dirty():
    """Whether tracked files have staged or unstaged modifications.
    Untracked files (research/ dirs) do not count, so apply can run
    with them present and git reset --hard still restores the tree."""
    unstaged = subprocess.run(
        ["git", "-C", TOP, "diff", "--quiet"]).returncode
    staged = subprocess.run(
        ["git", "-C", TOP, "diff", "--cached", "--quiet"]).returncode
    return bool(unstaged or staged)


def build_cmd():
    """The build invocation. Use the repo's nix shell when present so
    git's link libraries (zlib, openssl, curl, expat, pcre2) and the
    PERL_PATH/PYTHON_PATH/SHELL_PATH exports are on the path, else
    plain make. Bare nix-shell auto-loads ./shell.nix."""
    jobs = os.cpu_count() or 1
    make = f"make -j{jobs}"
    if os.path.isfile(os.path.join(TOP, "shell.nix")):
        return ["nix-shell", "--run", make]
    return ["sh", "-c", make]


def cmd_apply(mapfile, area, commit):
    if not area:
        sys.exit("git reorg apply: --area X is required")
    owner = load_map(mapfile)
    target = area_dir(owner, area)
    if not target:
        sys.exit(f"git reorg apply: unknown area '{area}'")
    if tracked_dirty():
        sys.exit("git reorg apply: tracked changes present")
    if not os.path.isdir(os.path.join(TOP, target)):
        sys.exit(f"git reorg apply: target dir {target}/ is absent")
    _, moves, _, _, headers = compute_plan(owner, area)
    if not moves:
        print("git reorg apply: nothing to do")
        return
    # Edit before moving so the renames carry the fixups. A failure
    # before any git mv leaves the tree recoverable with git reset.
    rewrite_includes(headers, target)             # include fixups
    moved_c = [os.path.basename(s) for s, _ in moves
               if s.endswith(".c")]
    patch_build(moved_c, target)                  # build fixups
    for src, dst in moves:                         # git mv pairs
        r = subprocess.run(["git", "-C", TOP, "mv", src, dst],
                           capture_output=True, text=True)
        if r.returncode:
            print(f"git reorg apply: git mv {src} failed: "
                  f"{r.stderr.strip()}")
            print(RECOVER)
            sys.exit(1)
    git("add", "-u")                               # stage tracked mods
    r = subprocess.run(build_cmd(), cwd=TOP)       # build check
    if r.returncode:
        print("git reorg apply: build failed; nothing committed.")
        print(RECOVER)
        sys.exit(1)
    if commit:                                     # commit
        subprocess.run(
            ["git", "-C", TOP, "commit", "-m",
             f"{area}: carve out {target}/"], check=True)
        print(f"git reorg apply: committed the {area} carve.")
    else:
        print("git reorg apply: build passed; carve is staged.")
        print(f"review, then commit, or {RECOVER}")


def take_opt(args, name):
    """Pop '--name VALUE' from args, returning (value, args)."""
    if name not in args:
        return None, args
    i = args.index(name)
    return args[i + 1], args[:i] + args[i + 2:]


def main():
    args = sys.argv[1:]
    here = os.path.dirname(os.path.abspath(__file__))
    mapfile = os.path.join(here, "git-layout.map")
    mapopt, args = take_opt(args, "--map")
    if mapopt:
        mapfile = mapopt
    area, args = take_opt(args, "--area")
    commit = "--commit" in args
    args = [a for a in args if a != "--commit"]
    cmd = args[0] if args else "check"
    if cmd == "check":
        cmd_check(mapfile)
    elif cmd == "plan":
        cmd_plan(mapfile, area)
    elif cmd == "apply":
        cmd_apply(mapfile, area, commit)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
