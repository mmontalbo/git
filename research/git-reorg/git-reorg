#!/usr/bin/env python3
"""git-reorg: enforce a declared source layout.

A thin launcher. Put this directory on sys.path, import the git
adapter (importing it registers the "git-c" triple), then hand control
to the core with git-c as the default triple and git-layout.map as the
default map. Run as: python3 research/git-reorg/git-reorg check
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

import reorg_core                       # noqa: E402
import reorg_git                        # noqa: E402  registers git-c


def main():
    mapref = os.path.join(_HERE, "git-layout.map")
    reorg_core.main(default_triple="git-c", default_mapref=mapref)


if __name__ == "__main__":
    main()
