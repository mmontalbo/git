#!/usr/bin/env python3
"""organize: enforce a declared source layout.

A thin launcher. Put this directory on sys.path, import the adapters
(importing each registers its triple: git-c, cohesion), then hand
control to the core with git-c as the default triple and
git-layout.map as the default map. Run as:
python3 research/git-organize/git-organize check
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

import organize_core                       # noqa: E402
import organize_git                        # noqa: E402  registers git-c
try:                                    # optional: the cohesion
    import organize_cohesion               # noqa: E402  triple needs the
except ImportError as e:                # untracked research/lib-reorg,
    _libreorg = os.path.join(_HERE, "..", "lib-reorg")
    if not os.path.isdir(_libreorg):    # so git-c works without it,
        organize_core.note_cohesion_absent(
            "install research/lib-reorg to enable it.")
    else:
        organize_core.note_cohesion_absent(
            f"cohesion module error: {e}.")


def main():
    mapref = os.path.join(_HERE, "git-layout.map")
    organize_core.main(default_triple="git-c", default_mapref=mapref)


if __name__ == "__main__":
    main()
