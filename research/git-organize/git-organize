#!/usr/bin/env python3
"""organize: enforce a declared source layout.

A thin launcher. Put this directory on sys.path, import the adapters
(importing each registers its triple: git-c, cohesion), then hand
control to the core with git-c as the default triple and
git-layout.map as the default map. Run as:
python3 research/git-organize/git-organize check
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

import organize_core                       # noqa: E402
import config_adapter                       # noqa: E402  the config triple


def _load_git():
    """Import the git-c adapter and, if present, cohesion. Deferred so a
    --config domain never triggers the git adapter's toplevel lookup,
    which lets a non-git project run with no git at all."""
    import organize_git                     # noqa: E402  registers git-c
    try:                                    # optional: the cohesion
        import organize_cohesion            # noqa: E402  triple needs the
    except ImportError:                     # untracked research/lib-reorg.
        pass                                # git-c works without it; the
        # core names no signal, so it needs no absent-reason string.


def _take_config(argv):
    """Pop '--config FILE' from argv, returning (path, argv). Additive:
    without it the launcher behaves exactly as before."""
    if "--config" not in argv:
        return None, argv
    i = argv.index("--config")
    return argv[i + 1], argv[:i] + argv[i + 2:]


def main():
    mapref = os.path.join(_HERE, "git-layout.map")
    cfg_path, sys.argv[1:] = _take_config(sys.argv[1:])
    if cfg_path is not None:
        # Load the config pair and dispatch it through the config
        # adapter, which routes the git-coupled commands (the default
        # status summary and apply --unconflicted) through the generic
        # seams and defers the rest to the core. The config supplies
        # every domain string; the launcher stays domain-neutral.
        name, cfg = config_adapter.register_config(cfg_path)
        config_adapter.dispatch(name, cfg["map"], sys.argv[1:])
        return
    _load_git()
    organize_core.main(default_triple="git-c", default_mapref=mapref)


if __name__ == "__main__":
    main()
